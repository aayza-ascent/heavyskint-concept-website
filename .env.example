# ─────────────────────────────────────────────────────────────
# Heavyskint — environment
# Copy to `.env.local` for development. Never commit `.env.local`.
# Production values go in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Sanity (content: shows, releases, gallery, copy) ─────────
# From sanity.io/manage after creating the project.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-09-07"
# Only needed for draft previews. Viewer-scoped token.
SANITY_API_READ_TOKEN=""
# Any long random string. Paste the SAME value into the Sanity webhook config.
# Generate with: openssl rand -base64 32
SANITY_REVALIDATE_SECRET=""

# ── Bandsintown (upcoming shows) ─────────────────────────────
# Bandsintown for Artists → Settings → API key. Leave empty and upcoming shows
# fall back to Sanity.
BANDSINTOWN_APP_ID=""

# ── Shopify (merch: products, inventory, orders) ─────────────
# Shopify admin → Settings → Apps → Develop apps → Storefront API
SHOPIFY_STORE_DOMAIN="heavyskint.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2026-07"
# Shopify admin → Settings → Notifications → Webhooks (shown once on creation)
SHOPIFY_WEBHOOK_SECRET=""

# ── Email (booking enquiries) ────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=""

# ── Mailing list (Mailchimp) ─────────────────────────────────
# Mailchimp → Profile → Extras → API keys → Create A Key. It ends in "-us22".
# Leave empty and the sign-up form sends visitors to the band's Mailchimp page
# (mailchi.mp/dbc5812d8359/heavyskint) instead of signing them up on the site.
MAILCHIMP_API_KEY=""
# The heavyskint audience. Only change it if the band moves to a new audience.
MAILCHIMP_AUDIENCE_ID="21aced4eee"
