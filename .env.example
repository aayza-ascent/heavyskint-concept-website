# ─────────────────────────────────────────────────────────────
# Heavyskint — environment
# Copy to `.env.local` for development. Never commit `.env.local`.
# Production values go in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Sanity (content: shows, releases, gallery, copy) ─────────
# From sanity.io/manage after creating the project.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-09-07"
# Only needed for draft previews. Viewer-scoped token.
SANITY_API_READ_TOKEN=""
# Write token, ONLY for the one-off `pnpm seed` run. Create at sanity.io/manage
# with Editor permissions. Never expose to the browser; not needed at runtime.
SANITY_API_WRITE_TOKEN=""
# Any long random string. Paste the SAME value into the Sanity webhook config.
# Generate with: openssl rand -base64 32
SANITY_REVALIDATE_SECRET=""

# ── Bandsintown (upcoming shows) ─────────────────────────────
# Bandsintown for Artists → Settings → API key. Leave empty and upcoming shows
# fall back to Sanity.
BANDSINTOWN_APP_ID=""

# ── Shopify (merch: products, inventory, orders) ─────────────
# Shopify admin → Settings → Apps → Develop apps → Storefront API
SHOPIFY_STORE_DOMAIN="heavyskint.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2026-07"
# Shopify admin → Settings → Notifications → Webhooks (shown once on creation)
SHOPIFY_WEBHOOK_SECRET=""

# ── Email (booking enquiries) ────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=""
# Where booking enquiries are delivered
BOOKING_EMAIL_TO="bookings@heavyskint.com"

# ── Mailing list ─────────────────────────────────────────────
# resend.com → Audience → Segments → create "Mailing list", copy its ID.
# Uses RESEND_API_KEY above. Leave empty and the sign-up form on the home page
# tells visitors sign-ups aren't open yet, rather than failing.
RESEND_NEWSLETTER_SEGMENT_ID=""
